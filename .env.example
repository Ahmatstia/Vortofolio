# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Web3Forms Access Key (for contact form redirection)
# Harus diawali dengan NEXT_PUBLIC_ agar bisa dibaca di Client Component (browser)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="MASUKKAN_ACCESS_KEY_DISINI"
